# ---------- Postgres (loja) ----------
POSTGRES_DB=casecellshop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop

# ---------- MySQL (ERP) ----------
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=erp
MYSQL_ROOT_PASSWORD=root

# ---------- DB loja / api (Postgres) ----------
DATABASE_URL=postgresql://shop:shop@postgres:5432/casecellshop?schema=public

# ---------- DB ERP (MySQL) ----------
ERP_DATABASE_URL=mysql://erp:erp@mysql:3306/erp

# ---------- api / worker (loja) ----------
REDIS_URL=redis://redis:6379
ERP_BASE_URL=http://erp:4000
PORT=3000
LOG_LEVEL=info
RESERVATION_TTL_MINUTES=15
ORDER_MAX_ATTEMPTS=5
ORDER_BACKOFF_MS=2000
SYNC_INTERVAL_MS=60000
RESERVATION_REAPER_INTERVAL_MS=30000
DEBUG_HOOKS=true
CACHE_TTL_SECONDS=20

# ---------- erp (simulado) ----------
ERP_PORT=4000
ERP_LOG_LEVEL=info
ERP_MIN_LATENCY_MS=200
ERP_MAX_LATENCY_MS=1500
ERP_FAILURE_RATE=0.15
ERP_TIMEOUT_RATE=0.05
ERP_TIMEOUT_MS=8000
ERP_ALLOW_SCENARIO_HEADER=true

# ---------- web (front) ----------
VITE_API_URL=http://localhost:3000
